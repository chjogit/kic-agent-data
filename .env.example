# 복사해서 .env 로 저장한 뒤 값을 채우세요 (copy .env.example .env). .env 는 커밋·공유하지 않습니다.

# Neon Postgres direct 연결 문자열 (호스트에 -pooler 가 없는 것)
DATABASE_URL=

# 공공데이터포털 일반 인증키(Decoding) — 금융위원회 주식시세정보 (국내 시세·상장주식수)
FSC_API_KEY=
# (선택) 공공데이터포털 서비스별로 다른 키를 쓸 때만. 비우면 FSC_API_KEY 사용
DATA_GO_KR_KEY=

# OpenDART (재무제표·공시 목록·기업개황)
DART_API_KEY=

# 한국은행 ECOS (기준금리·원/달러)
ECOS_API_KEY=
# 미국 FRED (10년물·연방기금금리·CPI·EUR/TWD 환율)
FRED_API_KEY=
# SEC EDGAR: 키 대신 '이름 이메일' 형식의 User-Agent
SEC_USER_AGENT=

# 네이버 개발자센터 검색 API (뉴스·블로그·카페)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER API HUB (네이버 클라우드) Search Trend — 검색 관심도
NCP_APIHUB_KEY_ID=
NCP_APIHUB_KEY=

# (선택) Finnhub 해외 종목 영문 뉴스 (finnhub.io 무료 키). 없으면 이 수집만 건너뜁니다
FINNHUB_API_KEY=

# ---- 웹 자동 실행(Vercel)용 ----
# /api/cron/tick 등을 부를 때 쓰는 비밀값 (아무 긴 문자열, 예: openssl rand -hex 24). Vercel Cron 이 자동으로 붙여 보냅니다
CRON_SECRET=
# (선택) 대시보드 비밀번호. 비우면 누구나 대시보드(읽기 전용)를 볼 수 있습니다
DASHBOARD_PASSWORD=
# (선택) tick 한 번에 새 작업을 시작할 수 있는 시간(초). 함수 최대 300초 안에서 여유를 둡니다
TICK_BUDGET_SECONDS=240

# (선택) 감성 분석 방식: lexicon(기본) | finbert
SENTIMENT_METHOD=lexicon
